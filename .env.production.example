# Docker Compose project isolation
COMPOSE_PROJECT_NAME=coderr-backend
APP_PORT=8001
MEDIA_DIR=./media

# Django
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.coderr.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.coderr.example.com,https://your-frontend.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# PostgreSQL
# Pin this deliberately for production. Do not change PostgreSQL major versions
# by editing the image tag on an existing database volume.
POSTGRES_IMAGE=postgres:18-alpine
DB_NAME=coderr
DB_USER=coderr
DB_PASSWORD=replace_with_a_strong_database_password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
