# Local development
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Local manage.py commands use SQLite when DB_HOST is not configured.
# Docker Compose supplies PostgreSQL settings separately through your .env.
# Uncomment these only when you intentionally run against PostgreSQL:
# DB_NAME=coderr
# DB_USER=coderr
# DB_PASSWORD=replace-with-a-local-db-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
